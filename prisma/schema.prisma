generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource digital_card {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String       @id @default(cuid())
  name        String
  description String
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Link {
  id        String  @id @default(cuid())
  label     String
  url       String
  sortOrder Int     @default(0)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model Skill {
  id        String  @id @default(cuid())
  name      String
  category  String
  sortOrder Int     @default(0)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model Experience {
  id           String        @id @default(cuid())
  company      String
  position     String
  location     String?
  website      String?
  startDate    DateTime
  endDate      DateTime?
  sortOrder    Int           @default(0)
  achievements Achievement[]
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model Achievement {
  id           String     @id @default(cuid())
  text         String
  sortOrder    Int        @default(0)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, sortOrder])
}
